{
  "name": "rn-escpos-printer",
  "version": "1.0.2",
  "description": "Reliable ESC/POS Bluetooth printing for React Native on iOS and Android",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "rn-escpos-printer-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "CHANGELOG.md",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace rn-escpos-printer-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build coverage lib",
    "prepare": "bob build",
    "prepublishOnly": "yarn verify",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "release:check": "node ./scripts/verify-release.mjs",
    "verify": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn prepare && npm pack --dry-run"
  },
  "keywords": [
    "react-native",
    "escpos",
    "esc-pos",
    "thermal-printer",
    "receipt-printer",
    "bluetooth",
    "ble",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardfariax/rn-escpos-printer.git"
  },
  "author": "Richard Farias <richardfariax@gmail.com> (https://github.com/richardfariax)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/richardfariax/rn-escpos-printer/issues"
  },
  "homepage": "https://github.com/richardfariax/rn-escpos-printer#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/eslint-config": "0.85.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.6",
    "babel-jest": "^29.7.0",
    "del-cli": "^7.0.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-builder-bob": "^0.43.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "example"
  ],
  "resolutions": {
    "fast-xml-parser": "5.7.0"
  },
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RnEscposPrinterSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.rnescposprinter"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  }
}
